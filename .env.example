# Copy to .env (or export these variables) before starting the server and the scripts.
# Use your own values; never commit a real .env file.
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=change-me
MONITOR_JWT_SECRET=replace-with-a-long-random-string
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8080
MONITOR_DEBUG=0
